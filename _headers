# The primary workers.dev host is for verification, not the production search URL.
https://inutaro-game.erikanuinui.workers.dev/*
  X-Robots-Tag: noindex

# Version preview URLs prefix the Worker name in the same hostname component.
https://:version-inutaro-game.erikanuinui.workers.dev/*
  X-Robots-Tag: noindex

# Only content-addressed immutable assets get a long browser cache lifetime.
/assets/versioned/*
  Cache-Control: public, max-age=31536000, immutable
